&CONTROL
  calculation = 'scf'
  prefix = 'mol_h2'
  outdir = './tmp'
  pseudo_dir = '../' ! your directory
/

&SYSTEM
  ibrav = 1
  celldm(1) = 20.0 
  nat = 2
  ntyp = 1
  ecutwfc = 60
  ecutrho = 480
/

&ELECTRONS
  conv_thr = 1.0d-8
/

ATOMIC_SPECIES
 H 1.008 H.pbe-kjpaw_psl.1.0.0.UPF

ATOMIC_POSITIONS angstrom
 H  0.0   0.0   0.0
 H  0.0   0.0   0.74

K_POINTS gamma
