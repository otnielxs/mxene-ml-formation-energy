&CONTROL
  calculation = 'relax'
  prefix = 'c'
  outdir = './tmp'
  pseudo_dir = '../' ! your directory
  nstep = 250
/

&SYSTEM
  ibrav = 4
  a = 2.46729
  c = 7.80307
  nat = 4
  ntyp = 1
  ecutwfc = 60
  ecutrho = 480
  occupations = 'smearing'
  smearing = 'mv'
  degauss = 0.02
/

&ELECTRONS
  conv_thr = 1.0d-8
/

&IONS
/

ATOMIC_SPECIES
  C  12.011 C.pbe-n-kjpaw_psl.1.0.0.UPF

ATOMIC_POSITIONS angstrom
 C   0.00000   0.00000   1.95077
 C   0.00000   0.00000   5.85230
 C  -0.00000   1.42449   1.95077
 C   1.23365   0.71225   5.85230

K_POINTS automatic
 12 12 12 0 0 0
